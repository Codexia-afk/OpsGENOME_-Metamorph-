# OpsGenome Environment Variables & API Keys Template
# Copy this file to .env and insert your real keys: cp .env.example .env

# Google Gemini API (Multimodal Semantic Reasoning & Root Cause Analysis)
GEMINI_API_KEY="your-gemini-api-key-here"

# Groq LPU API (Ultra-Fast Llama 3.3 70B Inference)
GROQ_API_KEY="gsk_your-groq-api-key-here"

# Anthropic Claude API (Semantic Disambiguation)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# Local Air-Gapped Ollama LLM (Optional fallback on localhost:11434)
OPSGENOME_LOCAL_LLM="0"
OLLAMA_HOST="http://localhost:11434"
